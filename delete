@usuario_bp.route('/competencias/eliminar/<int:registro_id>', methods=['POST'])
@login_required
def eliminar_competencia(registro_id):
    registro = Competencias.query.filter_by(
        id=registro_id,
        id_usuario=current_user.id
    ).first()

    if not registro:
        return jsonify({"ok": False, "error": "Registro no encontrado"}), 404

    db.session.delete(registro)
    db.session.commit()

    return jsonify({"ok": True})

