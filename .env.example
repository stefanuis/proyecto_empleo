# Copia este archivo como .env y completa los valores reales.
SECRET_KEY=genera-una-clave-larga-y-aleatoria
DATABASE_URL=mysql+pymysql://usuario:clave@localhost/nombre_bd

# 1 solo en tu equipo de desarrollo, nunca en un servidor
FLASK_DEBUG=0
# 0.0.0.0 para que otros equipos de la red accedan a la app
FLASK_HOST=127.0.0.1

MAIL_SERVER=in-v3.mailjet.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente: debe estar validado en Mailjet (Senders & Domains)
MAIL_DEFAULT_SENDER=noresponder@clinpanamericana.com
# Dirección con la que los candidatos abren el sitio. Los enlaces de los
# correos (activar cuenta, confirmar entrevista) se arman con ella.
URL_PUBLICA=https://empleo.clinpanamericana.com

# Minutos sin actividad antes de cerrar la sesión automáticamente
SESION_INACTIVA_MINUTOS=30
# 1 cuando el sitio funcione con HTTPS (la cookie de sesión solo viaja cifrada)
SESSION_COOKIE_SECURE=0
