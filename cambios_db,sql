-- ---------------------------------------------------------------------
-- 7. Funciones que exige cada vacante (coincidencia con el candidato)
--    Se comparan con tbl_perfil_funcion para ordenar a los postulantes.
-- ---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS tbl_vacante_funcion (
    id INT AUTO_INCREMENT PRIMARY KEY,
    id_vacante INT NOT NULL,
    id_funcion INT NOT NULL,
    UNIQUE KEY uq_vacante_funcion (id_vacante, id_funcion),
    KEY ix_tbl_vacante_funcion_id_vacante (id_vacante),
    CONSTRAINT fk_vacante_funcion_vacante
        FOREIGN KEY (id_vacante) REFERENCES tbl_vacante (id) ON DELETE CASCADE,
    CONSTRAINT fk_vacante_funcion_funcion
        FOREIGN KEY (id_funcion) REFERENCES tbl_funcion_area (id)
);

-- ---------------------------------------------------------------------
-- 8. Historial de cada postulación (quién hizo qué y cuándo)
--    id_autor NULL = evento del sistema (p. ej. respuesta a una citación).
-- ---------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS tbl_postulacion_historial (
    id INT AUTO_INCREMENT PRIMARY KEY,
    id_postulacion INT NOT NULL,
    id_autor INT NULL,
    accion VARCHAR(255) NOT NULL,
    detalle TEXT NULL,
    fecha DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    KEY ix_tbl_postulacion_historial_id_postulacion (id_postulacion),
    CONSTRAINT fk_historial_postulacion
        FOREIGN KEY (id_postulacion) REFERENCES tbl_postulacion (id) ON DELETE CASCADE,
    CONSTRAINT fk_historial_autor
        FOREIGN KEY (id_autor) REFERENCES tbl_usuario (id)
);
