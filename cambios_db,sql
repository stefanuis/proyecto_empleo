    area_aplicacion VARCHAR(100) NOT NULL,
    nombre VARCHAR(200) NOT NULL,
    activa BOOLEAN NOT NULL DEFAULT TRUE,
    UNIQUE KEY uq_area_nombre (area_aplicacion, nombre)
);

-- 2. Perfil profesional del candidato (una fila por usuario)
CREATE TABLE IF NOT EXISTS tbl_perfil_profesional (
    id INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL UNIQUE,
    area_aplicacion VARCHAR(100) NOT NULL,
    descripcion TEXT NOT NULL,
    fecha_actualizacion DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- 3. Funciones elegidas por el candidato
CREATE TABLE IF NOT EXISTS tbl_perfil_funcion (
    id INT AUTO_INCREMENT PRIMARY KEY,
